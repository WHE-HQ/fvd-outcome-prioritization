{ANSWERTABLE}]]></email_admin_responses>
    <surveyls_numberformat><![CDATA[0]]></surveyls_numberformat>
    <surveyls_language><![CDATA[en]]></surveyls_language>
    <surveyls_title><![CDATA[FVD therapeutics guideline: outcome prioritization]]></surveyls_title>
    <surveyls_description/>
    <surveyls_welcometext/>
    <surveyls_endtext><![CDATA[<p><strong>Thank you.</strong></p><p>Your ratings have been recorded. You can use the link in the email again to review or change them until the survey closes.</p><p>We will show you a summary of the results at or before the next guideline development group meeting.</p><p>WHO clinical management team</p>]]></surveyls_endtext>
    <surveyls_policy_notice/>
    <surveyls_policy_notice_label/>
    <surveyls_url/>
    <surveyls_urldescription/>
   </row>
  </rows>
 </surveys_languagesettings>
